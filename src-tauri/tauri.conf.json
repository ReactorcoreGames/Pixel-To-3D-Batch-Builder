{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pixel to 3D Batch Builder",
  "mainBinaryName": "Pixel to 3D Batch Builder",
  "version": "1.0.0",
  "identifier": "com.reactorcore.pixelto3d",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "Pixel to 3D Batch Builder",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 640,
        "center": true,
        "maximized": true,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "../branding/icon-32.png",
      "../branding/icon-128.png",
      "../branding/icon-256.png",
      "../branding/icon.ico"
    ],
    "resources": {
      "../presets/": "presets/",
      "../examples/": "examples/",
      "../public/guide/": "guide/"
    },
    "publisher": "Reactorcore",
    "shortDescription": "Turns pixel-art sprites into 3D models, voxel models and sprite sheets",
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
